<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="EJson" Manufacturer="EJson" Version="$(var.AppVersion)"
           UpgradeCode="AE572C65-E54B-47D6-AF89-63247B6A4AA4" Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer version of EJson is already installed."
                  Schedule="afterInstallInitialize" />
    <MediaTemplate EmbedCab="yes" />
    <Property Id="EJSON_BUILD_NUMBER" Value="$(var.BuildNumber)" />
    <Icon Id="EJsonIcon" SourceFile="../runner/resources/app_icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="EJsonIcon" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="EJson" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="EJson" Level="1">
      <Files Directory="INSTALLFOLDER" Include="$(var.BundleDir)\**">
        <Exclude Files="$(var.BundleDir)\ejson.exe" />
      </Files>
      <Component Directory="INSTALLFOLDER">
        <File Id="EJsonExe" Source="$(var.BundleDir)\ejson.exe" KeyPath="yes">
          <Shortcut Id="EJsonStartMenu" Directory="ProgramMenuFolder" Name="EJson"
                    WorkingDirectory="INSTALLFOLDER" Advertise="yes" />
        </File>
        <RegistryKey Root="HKLM" Key="Software\Classes\.json\OpenWithProgids">
          <RegistryValue Name="EJson.Json" Type="string" Value="" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="Software\Classes\EJson.Json">
          <RegistryValue Type="string" Value="JSON document" />
          <RegistryKey Key="DefaultIcon">
            <RegistryValue Type="string" Value="&quot;[#EJsonExe]&quot;,0" />
          </RegistryKey>
          <RegistryKey Key="shell\open\command">
            <RegistryValue Type="string" Value="&quot;[#EJsonExe]&quot; &quot;%1&quot;" />
          </RegistryKey>
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="Software\Classes\.jsonl\OpenWithProgids">
          <RegistryValue Name="EJson.Document" Type="string" Value="" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="Software\Classes\.ndjson\OpenWithProgids">
          <RegistryValue Name="EJson.Document" Type="string" Value="" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="Software\Classes\.xml\OpenWithProgids">
          <RegistryValue Name="EJson.Document" Type="string" Value="" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="Software\Classes\.csv\OpenWithProgids">
          <RegistryValue Name="EJson.Document" Type="string" Value="" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="Software\Classes\.yaml\OpenWithProgids">
          <RegistryValue Name="EJson.Document" Type="string" Value="" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="Software\Classes\.yml\OpenWithProgids">
          <RegistryValue Name="EJson.Document" Type="string" Value="" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="Software\Classes\.toml\OpenWithProgids">
          <RegistryValue Name="EJson.Document" Type="string" Value="" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="Software\Classes\EJson.Document">
          <RegistryValue Type="string" Value="Structured data document" />
          <RegistryKey Key="DefaultIcon">
            <RegistryValue Type="string" Value="&quot;[#EJsonExe]&quot;,0" />
          </RegistryKey>
          <RegistryKey Key="shell\open\command">
            <RegistryValue Type="string" Value="&quot;[#EJsonExe]&quot; &quot;%1&quot;" />
          </RegistryKey>
        </RegistryKey>
      </Component>
    </Feature>
  </Package>
</Wix>
