<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/yaml">
    <comment>YAML document</comment>
    <sub-class-of type="text/plain"/>
    <alias type="text/yaml"/>
    <alias type="text/x-yaml"/>
    <alias type="application/x-yaml"/>
    <glob pattern="*.yaml"/>
    <glob pattern="*.yml"/>
  </mime-type>
  <mime-type type="application/toml">
    <comment>TOML document</comment>
    <sub-class-of type="text/plain"/>
    <alias type="text/x-toml"/>
    <glob pattern="*.toml"/>
  </mime-type>
  <mime-type type="application/x-ndjson">
    <comment>JSON Lines document</comment>
    <sub-class-of type="text/plain"/>
    <glob pattern="*.jsonl"/>
    <glob pattern="*.ndjson"/>
  </mime-type>
</mime-info>
